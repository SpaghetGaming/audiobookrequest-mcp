{
  "name": "@spaghetgaming/audiobookrequest-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for AudioBookRequest - the lightweight audiobook request management tool for Plex/Audiobookshelf/Jellyfin.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "audiobookrequest-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/add-shebang.js",
    "start": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector npx tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "audiobookrequest",
    "audiobooks",
    "model-context-protocol",
    "plex",
    "audiobookshelf",
    "jellyfin"
  ],
  "author": "spaghetgaming",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spaghetgaming/audiobookrequest-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
